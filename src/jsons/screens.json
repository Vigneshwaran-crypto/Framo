{
  "Login": {
    "type": "View",
    "style": {
      "flex": 1,
      "justifyContent": "center",
      "alignItems": "center",
      "padding": 20,
      "backgroundColor": "white",
      "borderWidth": 1,
      "borderColor": "red"
    },
    "children": [
      {
        "type": "Text",
        "props": {
          "children": "Login"
        },
        "style": {
          "fontSize": 24,
          "marginBottom": 20,
          "fontWeight": "bold",
          "borderColor": "#ccc"
        }
      },
      {
        "type": "TextInput",
        "field": "email",
        "props": {
          "placeholder": "Email"
        },
        "style": {
          "borderWidth": 1,
          "borderColor": "#ccc",
          "padding": 12,
          "marginBottom": 16,
          "width": "85%",
          "borderRadius": 8
        }
      },
      {
        "type": "TextInput",
        "field": "password",
        "props": {
          "placeholder": "Password",
          "secureTextEntry": true
        },
        "style": {
          "borderWidth": 1,
          "borderColor": "#ccc",
          "padding": 12,
          "marginBottom": 24,
          "width": "85%",
          "borderRadius": 8
        }
      },
      {
        "type": "TouchableOpacity",
        "action": "logIn",
        "toScreen": "Settings",
        "props": {
          "title": "Sign In"
        },
        "style": {
          "backgroundColor": "#0066ff",
          "paddingVertical": 14,
          "borderRadius": 8,
          "width": "85%",
          "alignItems": "center"
        },
        "children": [
          {
            "type": "Text",
            "props": {
              "children": "Login"
            },
            "style": {
              "fontSize": 18,
              "color": "white",
              "fontWeight": "bold"
            }
          }
        ]
      }
    ]
  },
  "Settings": {
    "type": "View",
    "style": {
      "flex": 1,
      "justifyContent": "center",
      "alignItems": "center",
      "padding": 20,
      "backgroundColor": "white",
      "borderWidth": 5,
      "borderColor": "green"
    },
    "children": [
      {
        "type": "View",
        "style": {
          "flex": 1,
          "borderWidth": 2,
          "borderColor": "red"
        },
        "children": [
          {
            "type": "Image",
            "style": {
              "flex": 1,
              "borderWidth": 2,
              "borderColor": "yellow",
              "object-fit": "center"
            },
            "props": {
              "source": {
                "uri": "https://fastly.picsum.photos/id/16/2500/1667.jpg?hmac=uAkZwYc5phCRNFTrV_prJ_0rP0EdwJaZ4ctje2bY7aE"
              },
              "resizeMode": "cover"
            }
          }
        ]
      },
      {
        "type": "View",
        "style": {
          "flex": 1,
          "borderWidth": 2,
          "borderColor": "red"
        }
      }
    ]
  },
  "NewContact": {
    "type": "SafeAreaView",
    "style": {
      "flex": 1,
      "backgroundColor": "#f8f9fa",
      "borderWidth": 1,
      "borderColor": "red",
      "padding": 14
    },
    "children": [
      {
        "type": "Text",
